# Supabase Configuration
# IMPORTANT: Never commit .env file to version control!

# Public keys (safe for client-side use) - Required for frontend
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-side keys (MUST be kept secret) - Required for API routes and scripts
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# LiveATC Feed Configuration
LIVEATC_FEEDS='[
  {"airport": "KJFK", "facility": "ground", "url": "http://d.liveatc.net/kjfk_gnd"},
  {"airport": "KJFK", "facility": "tower", "url": "http://d.liveatc.net/kjfk_twr"},
  {"airport": "KSFO", "facility": "ground", "url": "http://d.liveatc.net/ksfo_gnd"},
  {"airport": "KORD", "facility": "ground", "url": "http://d.liveatc.net/kord_gnd"}
]'

# Recording Configuration
RECORDING_DURATION=600
RECORDING_SCHEDULE="0 * * * *"

# Segmentation Configuration
SILENCE_THRESHOLD=-40
SILENCE_DURATION=0.5
MIN_SEGMENT_DURATION=2
MAX_SEGMENT_DURATION=20

# Speech-to-Text Configuration
# Primary STT Provider: Deepgram
DEEPGRAM_API_KEY=your_deepgram_api_key

# Alternative STT Provider: HuggingFace
# Uncomment these to use HuggingFace instead of Deepgram
# HUGGINGFACE_API_KEY=hf_your_huggingface_api_key
# HUGGINGFACE_ENDPOINT=https://your-endpoint.endpoints.huggingface.cloud

# Optional: Explicitly set preferred STT provider (deepgram or huggingface)
# If not set, will auto-detect based on which API key is available
# PREFERRED_STT_PROVIDER=deepgram

# Google AI configuration (FlightTalk)
GOOGLE_API_KEY=your_google_api_key

# Edge Case Detection Configuration
EDGE_CASE_DETECTION_ENABLED=true
DETECTION_MODE=hybrid

# Audio-First Analysis Configuration
AUDIO_ANALYSIS_THRESHOLD=0.65
DEEPGRAM_KEYWORD_MODEL=nova-2
ENABLE_AUDIO_FIRST=true
ENABLE_KEYWORD_SPOTTING=true

# Edge Case Detection Thresholds
CONFIDENCE_THRESHOLD_RLHF=0.90
CONFIDENCE_THRESHOLD_HUMAN=0.90
